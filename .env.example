# PostgreSQL connection string used by Prisma.
# Copy this file to `.env` and adjust as needed.
# `docker compose up -d` provides this database locally, or point it at any
# PostgreSQL 18 server that has a `paynest_dev` database.
DATABASE_URL="postgresql://southboy@localhost:5432/paynest_dev?schema=public"

# Secret used by better-auth to sign/encrypt session cookies.
# Generate a real one with: openssl rand -base64 32
BETTER_AUTH_SECRET="change-me"

# Base URL of the app, used by better-auth for cookies and redirects.
BETTER_AUTH_URL="http://localhost:3000"
